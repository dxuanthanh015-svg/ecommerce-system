# Public website URL. For local Docker use http://localhost:8080.
PUBLIC_URL=http://localhost:8080
APP_HTTP_PORT=8080
COOKIE_SECURE=false

# Database credentials. Use strong, unique values before deploying publicly.
MYSQL_DATABASE=ecommerce_system_web
MYSQL_USER=nexcart
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# Required application secrets
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin

# Google OAuth. Register PUBLIC_URL/oauth2/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2/callback
GOOGLE_USER_INFO_URI=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
VITE_GOOGLE_SCOPE=openid email profile

# SMTP credentials (required by the current Spring configuration)
MAIL_USERNAME=your-smtp-account
MAIL_PASSWORD=your-smtp-app-password

# Redis is private to the Docker network in this Compose setup.
REDIS_PASSWORD=

# Optional integrations; leave blank when unused.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
S3_BUCKET=
AWS_REGION=ap-southeast-1
CLOUDFRONT_URL=
